# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env ke GitHub.

# Port server lokal (opsional, default 3000)
PORT=3000

# === Pilihan 1 (disarankan): Google Gemini — kunci gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY= 
# Opsional. Default: gemini-flash-lite-latest (paling cepat). Ganti ke gemini-flash-latest untuk jawaban lebih pintar.
GEMINI_MODEL=

# === Pilihan 2: penyedia OpenAI-compatible (mis. Groq, OpenRouter, OpenAI)
# Dipakai hanya jika GEMINI_API_KEY kosong.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Jika kedua kunci kosong, chatbot berjalan dalam "mode offline" (jawaban dari basis pengetahuan lokal).
